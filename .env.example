# ServiceCore Environment Variables (Example)
# Copy to .env and replace placeholder values before running outside dev mode.
# Never commit real secrets or .env files.

# HMAC-SHA256 signing secret for API bearer tokens (required when SERVICECORE_DEV_MODE!=1)
SERVICECORE_AUTH_SECRET=replace-with-strong-random-secret

# SQLite database path for SQLiteAuditStore
SERVICECORE_DB_PATH=/data/servicecore.sqlite

# Set to 1 to enable local dev token minting (/dev/token) and in-memory fallback
SERVICECORE_DEV_MODE=0

# Comma-separated allowed CORS origins for the FastAPI backend
SERVICECORE_CORS_ORIGINS=http://localhost:3000,http://localhost:3105

# Optional per-tenant sliding-window rate limit (requests per minute) for scan endpoints
SERVICECORE_RATE_LIMIT_PER_MINUTE=60

# Set to 1 to expose interactive OpenAPI docs (/docs, /redoc); set to 0 in hardened production
SERVICECORE_ENABLE_DOCS=1

# Optional HMAC-SHA256 secret for signing outbound monitor webhook alerts
SERVICECORE_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Optional Stripe webhook signing secret for POST /webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_secret

# Optional Anthropic API key for ClaudeSynthesizer (uses deterministic templates if unset)
ANTHROPIC_API_KEY=sk-ant-replace-with-api-key

# Base URL used by the Next.js Review Workbench API client
NEXT_PUBLIC_SERVICECORE_API_URL=http://localhost:8000
